generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(uuid())
  authId       String          @unique
  role         String          @default("USER")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  company      CompanyProfile?
  invoices     Invoice[]
  subscription Subscription?
  payments     Payment[]

  @@map("users")
}

model CompanyProfile {
  id                String     @id @default(uuid())
  userId            String     @unique
  fullName          String
  phone             String?
  email             String?
  website           String?
  companyName       String
  gstRegistered     Boolean    @default(false)
  gstin             String?
  pan               String?
  iecCode           String?
  arn               String?
  address           String
  city              String
  state             String
  pincode           String
  country           String     @default("India")
  bankName          String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankBranch        String?
  logoPath          String?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers         Customer[]
  invoices          Invoice[]
  items             Item[]
  settings          Settings?

  @@map("company_profiles")
}

model Customer {
  id               String          @id @default(uuid())
  name             String
  companyName      String
  address          String
  city             String?
  state            String?
  pincode          String?
  country          String          @default("India")
  phone            String?
  email            String?
  EximCode         String?
  gstin            String?
  pan              String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  companyProfileId String?
  company          CompanyProfile? @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  invoices         Invoice[]

  @@map("customers")
}

model Item {
  id               String          @id @default(uuid())
  name             String
  description      String?
  hsnCode          Int
  unit             String          @default("pcs")
  purchasePrice    Decimal         @default(0.00) @db.Decimal(10, 2)
  sellingPrice     Decimal         @default(0.00) @db.Decimal(10, 2)
  cgstRate         Decimal         @default(0.00) @db.Decimal(5, 2)
  sgstRate         Decimal         @default(0.00) @db.Decimal(5, 2)
  igstRate         Decimal         @default(0.00) @db.Decimal(5, 2)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  companyProfileId String?
  invoiceItems     InvoiceItem[]
  company          CompanyProfile? @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  @@map("items")
}

model Invoice {
  id               String         @id @default(uuid())
  userId           String
  companyProfileId String
  customerId       String
  invoiceNumber    String         @unique
  invoiceDate      DateTime
  dueDate          DateTime?
  marka            String?
  dateOfSupply     DateTime?
  stateCode        String?
  transportation   String?
  subtotal         Decimal        @db.Decimal(12, 2)
  cgstAmount       Decimal        @db.Decimal(12, 2)
  sgstAmount       Decimal        @db.Decimal(12, 2)
  igstAmount       Decimal        @db.Decimal(12, 2)
  totalAmount      Decimal        @db.Decimal(12, 2)
  amountInWords    String?
  notes            String?
  status           String         @default("DRAFT")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  invoiceItems     InvoiceItem[]
  company          CompanyProfile @relation(fields: [companyProfileId], references: [id])
  customer         Customer       @relation(fields: [customerId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  itemId      String?
  description String
  hsnCode     String?
  unit        String  @default("pcs")
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)
  cgstRate    Decimal @default(9.00) @db.Decimal(5, 2)
  sgstRate    Decimal @default(9.00) @db.Decimal(5, 2)
  igstRate    Decimal @default(18.00) @db.Decimal(5, 2)
  cgstAmount  Decimal @db.Decimal(10, 2)
  sgstAmount  Decimal @db.Decimal(10, 2)
  igstAmount  Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item        Item?   @relation(fields: [itemId], references: [id])

  @@map("invoice_items")
}

model Settings {
  id                String         @id @default(uuid())
  companyProfileId  String         @unique
  company           CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  invoicePrefix     String         @default("INV")
  nextInvoiceNumber Int            @default(1)
  defaultCgstRate   Decimal        @default(9.00) @db.Decimal(5, 2)
  defaultSgstRate   Decimal        @default(9.00) @db.Decimal(5, 2)
  defaultIgstRate   Decimal        @default(18.00) @db.Decimal(5, 2)
  termsConditions   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("settings")
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan   @default(FREE)
  status          SubscriptionStatus @default(TRIAL)
  startDate       DateTime           @default(now())
  endDate         DateTime?
  trialEndDate    DateTime?
  paymentMethod   String?
  lastPaymentDate DateTime?
  nextBillingDate DateTime?
  amount          Decimal            @default(0) @db.Decimal(10, 2)
  currency        String             @default("INR")
  invoiceLimit    Int                @default(10)
  invoicesUsed    Int                @default(0)
  customersLimit  Int                @default(50)
  itemsLimit      Int                @default(100)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus
  paymentMethod     String
  transactionId     String?       @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
