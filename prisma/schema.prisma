generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  authId    String   @unique
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  CompanyProfile? // 1-to-1
  invoices Invoice[]
}

model CompanyProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Personal Info
  fullName String
  phone    String?
  email    String?
  website  String?

  // Company Info
  companyName   String
  gstRegistered Boolean @default(false)
  gstin         String?
  pan           String?
  iecCode       String?
  arn           String?

  // Address
  address String
  city    String
  state   String
  pincode String
  country String @default("India")

  // Bank Details
  bankName          String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankBranch        String?

  logoPath  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers Customer[]
  items     Item[]
  invoices  Invoice[]

  @@map("company_profiles")
}

model Customer {
  id               String   @id @default(uuid())
  name             String
  companyName      String
  address          String
  city             String?
  state            String?
  pincode          String?
  country          String   @default("India")
  phone            String?
  email            String?
  EximCode         String?
  gstin            String?
  pan              String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  companyProfileId String

  company  CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("customers")
}

model Item {
  id               String   @id @default(uuid())
  name             String
  description      String?
  hsnCode          Int
  unit             String   @default("pcs")
  purchaseRate     Decimal  @db.Decimal(10, 2)
  sellingRate      Decimal  @db.Decimal(10, 2)
  cgstRate         Decimal  @default(0.00) @db.Decimal(5, 2)
  sgstRate         Decimal  @default(0.00) @db.Decimal(5, 2)
  igstRate         Decimal  @default(0.00) @db.Decimal(5, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  companyProfileId String

  company      CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@map("items")
}

model Invoice {
  id             String    @id @default(uuid())
  userId         String
  companyId      String
  customerId     String
  invoiceNumber  String    @unique
  invoiceDate    DateTime
  dueDate        DateTime?
  marka          String?
  dateOfSupply   DateTime?
  stateCode      String?
  transportation String?
  subtotal       Decimal   @db.Decimal(12, 2)
  cgstAmount     Decimal   @db.Decimal(12, 2)
  sgstAmount     Decimal   @db.Decimal(12, 2)
  igstAmount     Decimal   @db.Decimal(12, 2)
  totalAmount    Decimal   @db.Decimal(12, 2)
  amountInWords  String?
  notes          String?
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      CompanyProfile @relation(fields: [companyId], references: [id])
  customer     Customer       @relation(fields: [customerId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  invoiceItems InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  itemId      String?
  description String
  hsnCode     String?
  unit        String  @default("pcs")
  quantity    Int
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)
  cgstRate    Decimal @default(9.00) @db.Decimal(5, 2)
  sgstRate    Decimal @default(9.00) @db.Decimal(5, 2)
  igstRate    Decimal @default(18.00) @db.Decimal(5, 2)
  cgstAmount  Decimal @db.Decimal(10, 2)
  sgstAmount  Decimal @db.Decimal(10, 2)
  igstAmount  Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id])

  @@map("invoice_items")
}

